#!/usr/bin/env bash
# TradeStream CLI runner
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure java is on PATH without hardcoding user or cache hashes
if ! command -v java >/dev/null 2>&1 && [[ -z "${JAVA_HOME:-}" ]]; then
    for candidate in "${HOME}/.cache/bazel"/_bazel_*/install/*/embedded_tools/jdk/bin/java; do
        if [[ -x "${candidate}" ]]; then
            export PATH="$(dirname "${candidate}"):${PATH}"
            break
        fi
    done
fi

# Ensure ~/.local/bin is on PATH if present
if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]] && [[ -d "${HOME}/.local/bin" ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

BIN_PATH="${SCRIPT_DIR}/bazel-bin/src/main/java/com/verlumen/tradestream/backtesting/cli/backtest_cli"

if [[ ! -x "${BIN_PATH}" ]]; then
    bazel build --remote_cache= --bes_backend= //src/main/java/com/verlumen/tradestream/backtesting/cli:backtest_cli >&2
fi

exec "${BIN_PATH}" "$@"
